<Window xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options" x:Class="LiquidGlassMonitor.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Liquid Glass Monitor" Width="172" Height="345" MinWidth="172" MinHeight="345" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanResize" Topmost="False" PreviewMouseLeftButtonDown="Widget_PreviewMouseLeftButtonDown">
<Window.Resources>
    <TranslateTransform x:Key="ClockTranslateV49" Y="-3"/>
 <SolidColorBrush x:Key="Panel" Color="#2A3443" Opacity="0.85" po:Freeze="False"/>
 <SolidColorBrush x:Key="SubPanel" Color="#683C4B60" po:Freeze="False"/>
 <SolidColorBrush x:Key="ForegroundMuted" Color="#B4C8D7"/>
 <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F0F5FC"/><Setter Property="FontFamily" Value="Segoe UI"/></Style>
 <Style TargetType="Button"><Setter Property="Foreground" Value="#E8F4FF"/><Setter Property="Background" Value="#553E5267"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="9,5"/><Setter Property="Cursor" Value="Hand"/></Style>
 </Window.Resources>
<Viewbox x:Name="ScaleContainer" Stretch="Uniform" VerticalAlignment="Bottom">
 <Border x:Name="MainGlassBorder" Margin="9" CornerRadius="27" Background="{StaticResource Panel}" BorderBrush="#607E95AA" BorderThickness="1" SnapsToDevicePixels="True">
 <Border.Effect><DropShadowEffect BlurRadius="25" ShadowDepth="6" Color="#A0000000" Opacity="0.65"/></Border.Effect>
 <Grid x:Name="ContentRootGrid" Margin="20,17,20,16">
<Grid x:Name="MainContentGrid" Width="254.4" Background="Transparent"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Grid.Row="0"
      Background="Transparent"
      MinHeight="36"
      MouseLeftButtonDown="Header_MouseLeftButtonDown"
>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="Transparent" MinHeight="30"/>
<StackPanel Grid.Column="0"
            Orientation="Vertical"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            IsHitTestVisible="False">
    <StackPanel.Resources>
        <TranslateTransform x:Key="HeaderDateShiftV50" Y="-3"/>
    </StackPanel.Resources>
    <StackPanel Orientation="Horizontal"
            HorizontalAlignment="Left"
            RenderTransform="{StaticResource HeaderDateShiftV50}">
    <TextBlock x:Name="HeaderClockText"
               Text="--:--"
               FontSize="16"
               FontWeight="SemiBold"
               Foreground="#F0F5FC"/>
    <TextBlock x:Name="HeaderDateText"
               Text="--/--/--"
               FontSize="12"
               Foreground="#BFCDDD"
               Margin="12,0,0,0"
               VerticalAlignment="Center"/>
</StackPanel>
<StackPanel x:Name="BatteryHeader"
            Grid.Column="0"
            Orientation="Horizontal"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            IsHitTestVisible="False">

    <Viewbox Width="25"
         Height="15"
         Stretch="Uniform"
         Margin="0,0,6,0">
    <Canvas Width="25" Height="15">

        <Rectangle x:Name="BatteryFill"
                   Canvas.Left="2"
                   Canvas.Top="4"
                   Width="0"
                   Height="7"
                   Fill="#65D99A"/>

        <Path x:Name="BatteryBody"
              Stroke="#DCE5F0"
              StrokeThickness="1.5"
              Fill="Transparent"
              Data="M 1,2 L 19,2 Q 21,2 21,4 L 21,11 Q 21,13 19,13 L 1,13 Q 0,13 0,11 L 0,4 Q 0,2 1,2 Z"/>

        <Rectangle Canvas.Left="22"
                   Canvas.Top="4.5"
                   Width="2"
                   Height="6"
                   Fill="#DCE5F0"/>

        <Path x:Name="BatteryBolt"
      Fill="#FFFFFF"
      Data="M 12,1 L 7,8 L 11,8 L 9,14 L 16,6 L 12,6 Z"
      Visibility="Collapsed"/>
    </Canvas>
</Viewbox>

    <TextBlock x:Name="BatteryText"
               Text="-- %"
               Foreground="#F0F5FC"
               FontSize="13"
               FontWeight="SemiBold"
               VerticalAlignment="Center"/>

    <TextBlock x:Name="BatterySourceText"
               Text=""
               Foreground="{StaticResource ForegroundMuted}"
               FontSize="11"
               Margin="5,0,0,0"
               VerticalAlignment="Center"/>

</StackPanel>
</StackPanel>
   <Grid x:Name="HeaderActions" Grid.ColumnSpan="5" Opacity="0" Panel.ZIndex="1000" HorizontalAlignment="Right"><Grid><Grid.ColumnDefinitions>
    <ColumnDefinition Width="Auto"/>
    <ColumnDefinition Width="Auto"/>
    <ColumnDefinition Width="Auto"/>
    <ColumnDefinition Width="Auto"/>
</Grid.ColumnDefinitions><Button Grid.Column="1" x:Name="SettingsButton" Tag="{StaticResource Panel}"
        Click="Settings_Click"
        Content="&#x2699;"
        Margin="0,0,7,0"
        ToolTip="Personnalisation">
    <Button.ContextMenu>
        <ContextMenu x:Name="GlassSettingsMenu"
                     Placement="Bottom"
                     StaysOpen="True"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0">
            <ContextMenu.Template>
                <ControlTemplate TargetType="ContextMenu">
                    <Border x:Name="GlassSettingsBorder"
                            Background="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                            CornerRadius="17"
                            BorderBrush="#607E95AA"
                            BorderThickness="1"
                            Padding="15">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20"
                                              ShadowDepth="5"
                                              Color="#000000"
                                              Opacity="0.65"/>
                        </Border.Effect>
                        <ItemsPresenter/>
                    </Border>
                </ControlTemplate>
            </ContextMenu.Template>
            <MenuItem StaysOpenOnClick="True">
                <MenuItem.Template>
                    <ControlTemplate TargetType="MenuItem">
                        <ContentPresenter ContentSource="Header"/>
                    </ControlTemplate>
                </MenuItem.Template>
                <MenuItem.Header>
                    <StackPanel Width="220">
                        <TextBlock x:Name="OpacityLanguageLabel" Text="OPACITE"
                                   Margin="0,0,0,8"/>
                        <Slider x:Name="OpacitySlider"
                                Minimum="30"
                                Maximum="100"
                                Value="85"
                                TickFrequency="5"
                                IsSnapToTickEnabled="False"
                                ValueChanged="OpacitySlider_ValueChanged"/>

                        <TextBlock x:Name="GlassTintLanguageLabel" Text="TEINTE DU VERRE"
                                   Margin="0,17,0,8"/>

                        <Border Height="13"
                                CornerRadius="6"
                                Margin="0,0,0,4">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0.5"
                                                     EndPoint="1,0.5">
                                    <GradientStop Color="#FF3030" Offset="0"/>
                                    <GradientStop Color="#FFFF30" Offset="0.1667"/>
                                    <GradientStop Color="#30FF30" Offset="0.3333"/>
                                    <GradientStop Color="#30FFFF" Offset="0.5"/>
                                    <GradientStop Color="#3030FF" Offset="0.6667"/>
                                    <GradientStop Color="#FF30FF" Offset="0.8333"/>
                                    <GradientStop Color="#FF3030" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <Slider x:Name="HueSlider"
                                Minimum="0"
                                Maximum="360"
                                Value="210"
                                TickFrequency="1"
                                IsSnapToTickEnabled="False"
                                ValueChanged="HueSlider_ValueChanged"/>

                        <Button x:Name="ResetGlassHueLanguageButton" Content="Couleur d'origine"
                                Margin="0,12,0,0"
                                Click="ResetGlassHue_Click"/>
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>
        </ContextMenu>
    </Button.ContextMenu>
</Button>
   <Button Grid.Column="2" x:Name="LockButton" Content="🔓" Click="Lock_Click" Margin="0,0,7,0" ToolTip="Verrouiller la position"/>
   <Button Grid.Column="3" x:Name="CloseButton" Content="✕" Click="Close_Click" ToolTip="Fermer"/>
    <Button Grid.Column="0"
            x:Name="CompactButton"
            Content="&#x2922;"
            Click="Compact_Click"
            Margin="7,0,0,0"
            ToolTip="Mode compact"/>
  </Grid></Grid></Grid>
  <UniformGrid x:Name="NormalGauges" Grid.Row="1" Columns="3" Margin="0,4,0,6">
   <Grid Width="80" Height="80"><Ellipse Stroke="#374E61" StrokeThickness="7" Margin="5"/><Ellipse x:Name="CpuRing" Stroke="#70DDE5" StrokeThickness="7" Margin="5" StrokeDashArray="0,100" StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><RotateTransform Angle="-90"/></Ellipse.RenderTransform></Ellipse><StackPanel VerticalAlignment="Center"><TextBlock Text="CPU" HorizontalAlignment="Center" FontSize="12"/><TextBlock x:Name="CpuValue" Text="--%" HorizontalAlignment="Center" FontSize="23" FontWeight="SemiBold"/></StackPanel></Grid>
   <Grid Width="80" Height="80"><Ellipse Stroke="#374E61" StrokeThickness="7" Margin="5"/><Ellipse x:Name="RamRing" Stroke="#90A8FF" StrokeThickness="7" Margin="5" StrokeDashArray="0,100" StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><RotateTransform Angle="-90"/></Ellipse.RenderTransform></Ellipse><StackPanel VerticalAlignment="Center"><TextBlock Text="RAM" HorizontalAlignment="Center" FontSize="12"/><TextBlock x:Name="RamValue" Text="--%" HorizontalAlignment="Center" FontSize="23" FontWeight="SemiBold"/></StackPanel></Grid>
   <Grid Width="80" Height="80"><Ellipse Stroke="#374E61" StrokeThickness="7" Margin="5"/><Ellipse x:Name="GpuRing" Stroke="#C6A0F9" StrokeThickness="7" Margin="5" StrokeDashArray="0,100" StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><RotateTransform Angle="-90"/></Ellipse.RenderTransform></Ellipse><StackPanel VerticalAlignment="Center"><TextBlock Text="GPU" HorizontalAlignment="Center" FontSize="12"/><TextBlock x:Name="GpuValue" Text="N/D" HorizontalAlignment="Center" FontSize="20" FontWeight="SemiBold"/></StackPanel></Grid>
  </UniformGrid>
  <Border x:Name="CpuGraphPanel" Grid.Row="2" Background="{StaticResource SubPanel}" CornerRadius="16" Padding="13" Margin="0,0,0,13"><StackPanel><DockPanel><TextBlock x:Name="CpuActivityLanguageLabel" Text="ACTIVITÉ CPU" FontSize="15.6" FontWeight="SemiBold"/><TextBlock x:Name="CpuDurationLanguageLabel" Text="60 secondes" Foreground="{StaticResource ForegroundMuted}" FontSize="14.3" HorizontalAlignment="Right" DockPanel.Dock="Right"/></DockPanel><Canvas Height="80" x:Name="GraphCanvas" SizeChanged="Graph_SizeChanged" Margin="0,9,0,0"><Polyline x:Name="CpuGraph" Stroke="#70DDE5" StrokeThickness="2.5" StrokeLineJoin="Round"/></Canvas></StackPanel></Border>
    <Grid x:Name="CompactLayout"
      Grid.Row="1"
      Visibility="Collapsed">
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="40"/>
    </Grid.ColumnDefinitions>

    <ScrollViewer x:Name="CompactGaugeScroll"
                  Grid.Column="0"
                  Width="318"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Disabled"
                  CanContentScroll="False">
        <StackPanel x:Name="CompactDrivesPanel"
                    Orientation="Horizontal"
                    HorizontalAlignment="Left"/>
    </ScrollViewer>

    <StackPanel x:Name="CompactActionsPanel"
                Grid.Column="1"
                Width="36"
                VerticalAlignment="Center"
                HorizontalAlignment="Right"/>
</Grid>
  <DockPanel x:Name="StorageHeading" Grid.Row="3" Margin="2,0,2,10"><TextBlock x:Name="StorageLanguageLabel" Text="STOCKAGE" FontSize="15.6" FontWeight="SemiBold"/><TextBlock x:Name="DrivesLanguageLabel" Text="Volumes détectés" DockPanel.Dock="Right" Foreground="{StaticResource ForegroundMuted}" FontSize="14.3" HorizontalAlignment="Right"/></DockPanel>
  <ScrollViewer x:Name="StorageScroll" Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="DrivesPanel"/></ScrollViewer>
  <DockPanel x:Name="FooterPanel"
           Grid.Row="5"
           Margin="0,12,0,0"
           LastChildFill="False">
    <TextBlock x:Name="RefreshLanguageLabel" Text="Actualisation : 1 s"
               DockPanel.Dock="Left"
               Foreground="{StaticResource ForegroundMuted}"
               FontSize="13"/>
    <TextBlock x:Name="StatusText"
               Visibility="Collapsed"/>
    
</DockPanel>
  <Border x:Name="CarouselEmptyPage"
        Grid.Row="1"
        Grid.RowSpan="5"
        Background="Transparent"
        Visibility="Collapsed"
        Panel.ZIndex="50">
    <Grid>
        <StackPanel x:Name="NetworkPage" Margin="0,9,0,26" VerticalAlignment="Top">
            <Grid Margin="0,0,0,10">
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <TextBlock Grid.Column="0"
               x:Name="NetworkLanguageLabel" Text="RÉSEAU"
               FontSize="16"
               FontWeight="SemiBold"
               VerticalAlignment="Center"/>

    <StackPanel Grid.Column="1"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Margin="8,0,0,0"
                RenderTransformOrigin="0.5,0.5">
                <StackPanel.RenderTransform>
                    <TranslateTransform X="-7" Y="0"/>
                </StackPanel.RenderTransform>

        <TextBlock x:Name="NetworkConnectionLanguageLabel" Text="CONNEXION ACTIVE : "
                   FontSize="9"
                   Foreground="{StaticResource ForegroundMuted}"
                   VerticalAlignment="Center"/>

        <TextBlock x:Name="NetworkInterfaceText"
                   Text="Détection..."
                   FontSize="11"
                   FontWeight="SemiBold"
                   MaxWidth="115"
                   TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center"/>
    </StackPanel>
</Grid>
            <Grid Margin="0,0,0,9">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{StaticResource SubPanel}" CornerRadius="12" Padding="10,9" Margin="0,0,4,0">
                    <StackPanel><TextBlock x:Name="NetworkDownloadLanguageLabel" Text="↓ RÉCEPTION" Foreground="#79B9FF" FontSize="11"/>
                    <TextBlock x:Name="NetworkDownText" Text="—" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="Mo/s" FontSize="10" Foreground="{StaticResource ForegroundMuted}"/></StackPanel>
                </Border>
                <Border Grid.Column="1" Background="{StaticResource SubPanel}" CornerRadius="12" Padding="10,9" Margin="4,0,0,0">
                    <StackPanel><TextBlock x:Name="NetworkUploadLanguageLabel" Text="↑ ENVOI" Foreground="#83DDC4" FontSize="11"/>
                    <TextBlock x:Name="NetworkUpText" Text="—" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="Mo/s" FontSize="10" Foreground="{StaticResource ForegroundMuted}"/></StackPanel>
                </Border>
            </Grid>
            <Border Background="{StaticResource SubPanel}" CornerRadius="12" Padding="10,9" Margin="0,0,0,9">
                <StackPanel>
                    <TextBlock x:Name="NetworkTrafficLanguageLabel" Text="TRAFIC — 60 SECONDES" FontSize="11" Foreground="{StaticResource ForegroundMuted}"/>
                    <Canvas x:Name="NetworkGraphCanvas" Height="74" Margin="0,8,0,3" SizeChanged="NetworkGraph_SizeChanged">
                        <Polyline x:Name="NetworkDownGraph" Stroke="#79B9FF" StrokeThickness="2" StrokeLineJoin="Round"/>
                        <Polyline x:Name="NetworkUpGraph" Stroke="#83DDC4" StrokeThickness="2" StrokeLineJoin="Round"/>
                    </Canvas>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock x:Name="NetworkDownloadLegendLanguageLabel" Text="● Réception" Foreground="#79B9FF" FontSize="10" Margin="0,0,12,0"/>
                        <TextBlock x:Name="NetworkUploadLegendLanguageLabel" Text="● Envoi" Foreground="#83DDC4" FontSize="10"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Background="{StaticResource SubPanel}" CornerRadius="12" Padding="10,9">
                <StackPanel>
                    <!-- IpLocaleSurvol_2026 -->
                    <DockPanel Margin="0,0,0,6">
                        <DockPanel.Style>
                            <Style TargetType="DockPanel">
                                <Setter Property="Visibility" Value="Hidden"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}"
                                                 Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DockPanel.Style><TextBlock x:Name="NetworkLocalIpLanguageLabel" Text="IP locale" Foreground="{StaticResource ForegroundMuted}" FontSize="11"/>
                        <TextBlock x:Name="NetworkIpText" Text="—" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="11"/></DockPanel>
                    <DockPanel><TextBlock x:Name="NetworkLatencyLanguageLabel" Text="Latence Internet" Foreground="{StaticResource ForegroundMuted}" FontSize="11"/>
                        <TextBlock x:Name="NetworkPingText" Text="—" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="11"/></DockPanel>
                </StackPanel>
            </Border>
        </StackPanel>
        <StackPanel x:Name="CarouselDots"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,8">
            <Ellipse Width="5" Height="5" Margin="4,0"
                     Fill="#B4C8D7"/>
            <Ellipse Width="5" Height="5" Margin="4,0"
                     Fill="#B4C8D7"/>
            <Ellipse Width="5" Height="5" Margin="4,0"
                     Fill="#B4C8D7"/>
            <Ellipse Width="5" Height="5" Margin="4,0"
                     Fill="#B4C8D7"/>
            <Ellipse Width="5" Height="5" Margin="4,0"
                     Fill="#B4C8D7"/>
        </StackPanel>
    </Grid>
</Border>
 </Grid>
<Border x:Name="ResizeHandle" Width="21"
        Height="21"
        HorizontalAlignment="Right"
        VerticalAlignment="Bottom"
        Margin="0,0,-10,-8"
        Background="Transparent"
        Cursor="SizeNWSE"
        Panel.ZIndex="100"
        MouseLeftButtonDown="ResizeHandle_MouseLeftButtonDown">
    <Path Data="M 7,17 L 17,7 M 12,17 L 17,12"
          Stroke="#A8BBCB"
          StrokeThickness="2"
          StrokeStartLineCap="Round"
          StrokeEndLineCap="Round"/>
</Border></Grid>
 </Border>
</Viewbox>
</Window>